# Formatting rules this repository enforces. Two of them are also pinned by
# RepositoryConventionsTests, so they survive an editor that ignores this file.
root = true

[*]
charset = utf-8
# Every file in this repository ends on its last line of content: no trailing
# blank line. dotnet format and most editors honour this, and the convention test
# catches the ones that do not.
insert_final_newline = false
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Razor, CSS and JavaScript are indented with 4 spaces too, matching the C#.
[*.{css,js,cshtml}]
indent_size = 4

# JSON is the one place a 2-space indent is conventional, and it is copied out
# of appsettings untouched.
[*.{json,yml,yaml}]
indent_size = 2

# Markdown is prose: trailing whitespace is meaningful (hard line break), so it is
# left alone here.
[*.md]
trim_trailing_whitespace = false

# Solution files are generated by the tooling; do not reformat them.
[*.sln]
indent_style = tab